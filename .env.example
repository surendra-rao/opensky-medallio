# Copy this file to .env and fill in your OpenSky API client credentials.
# NEVER commit .env to GitHub.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Where raw files land (Week 2 switches this to MinIO)
BRONZE_ROOT=data/bronze

# 300 = every 5 minutes
POLL_INTERVAL_SECONDS=300
REQUEST_TIMEOUT=30
MAX_RETRIES=3
